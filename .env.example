# Supabase Configuration
# Эти переменные используются для подключения к базе данных и авторизации
#
# Как получить эти значения:
# 1. Зайдите на https://supabase.com
# 2. Создайте новый проект
# 3. Перейдите в Settings -> API
# 4. Скопируйте "Project URL" и "anon public" ключ
#
# В продакшене обязательно создайте файл .env с реальными значениями
# НЕ коммитьте .env в git!

# URL вашего Supabase проекта
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Публичный (anon) ключ Supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# для подсказок
VSEGPT_API_KEY=your_api_key
VSEGPT_MODEL=openai/gpt-3.5-turbo
VSEGPT_MODEL_FORMATTER=qwen/qwen3-next-80b-a3b